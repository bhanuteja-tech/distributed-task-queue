# ==============================================================================
# Distributed Task Queue System - Configuration Environment Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=distributed-task-queue

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# PostgreSQL Database Configuration
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/taskqueue
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_TIMEOUT_SECONDS=15

# RabbitMQ Broker Configuration
# Format: amqp://<user>:<password>@<host>:<port>/<vhost>
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=taskqueue.direct
RABBITMQ_QUEUE_PREFIX=taskqueue.tasks
RABBITMQ_DEAD_LETTER_EXCHANGE=taskqueue.dlx
RABBITMQ_DEAD_LETTER_QUEUE=taskqueue.tasks.dlq
RABBITMQ_PUBLISHER_CONFIRMS=true
RABBITMQ_CONNECTION_RETRIES=5
RABBITMQ_RETRY_INTERVAL_SECONDS=2.0

# Redis Configuration (Optional read-through status cache)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=300
REDIS_SOCKET_TIMEOUT_SECONDS=2.0

# Worker Configuration
WORKER_CONCURRENCY=5
WORKER_PREFETCH_COUNT=10
WORKER_LEASE_DURATION_SECONDS=60
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_SHUTDOWN_TIMEOUT_SECONDS=15

# Outbox Publisher Configuration
OUTBOX_POLL_INTERVAL_SECONDS=1.0
OUTBOX_BATCH_SIZE=50
OUTBOX_LOCK_TIMEOUT_SECONDS=30

# Lease Reaper Configuration (Abandoned task recovery)
REAPER_INTERVAL_SECONDS=10.0
REAPER_BATCH_SIZE=50

# Retry Policy Defaults
DEFAULT_MAX_ATTEMPTS=3
DEFAULT_INITIAL_RETRY_DELAY_SECONDS=2.0
DEFAULT_MAX_RETRY_DELAY_SECONDS=60.0
DEFAULT_EXPONENTIAL_BACKOFF_BASE=2.0
DEFAULT_JITTER=true

